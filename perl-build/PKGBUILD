# Maintainer: Ian Bradley <crabapp@hikki.tech>
_pkgname=perl-build
pkgname=$_pkgname-git
pkgver=0.01.1
pkgrel=1
pkgdesc="Build system for PKGBUILD based Linux distributions"
arch=(any)
license=('Artistic-1.0-Perl' 'GPL-1.0-or-later')
depends=('perl')
makedepends=('git' 'perl-syntax-keyword-try' 'perl-cpanel-json-xs' 'perl-module-build' 'perl-dbi' 'cpanminus' 'perl-inline-c' 'perl-path-tiny' 'perl-net-ssleay' 'git')
options=('!emptydirs' 'staticlibs')
url="https://github.com/tokuhirom/$_pkgname"
_commit=e56e4e44816cb1f9912bf560cc8b86bff609da68
source=("git+$url.git#commit=$_commit"
	"0001-fix-pinned-perl-and-refresh-build-scripts.patch")
b2sums=('2ba24ccd7141b748de94a2dcbb682301e816b1657cc44dfb1203d8287ca19bd22d79c61c60179ecaa42c368d12281405dcdb400af0f07e0fe140cf19e5b7826d'
        '491ccfbcb8af5f15ac4a84a29a640499b0b0414b513fa01cf68a4ab20a96d41e264ca71026d5106f536bbfa093062c1b7b5575a714c70eee1e53667b8a7f1cee')
sha512sum=('cd3937afa78831f80a2ad5abab6c51b9e82fca4c31e5856ea208d598db5dc867')
validpgpkeys=(4D8733704B740FC4B330EF5E8FFAD8B7BA73987)

prepare() {
  cd "$srcdir/$_pkgname"
  patch -Np1 -i "$srcdir/${source[*]:1:1}" #../0001-fix-pinned-perl-and-refresh-build-scripts.patch
  unset PERL5LIB PERL_MM_OPT PERL_MB_OPT PERL_LOCAL_LIB_ROOT
  export PERL_CPANM_OPT="-Llocal --verbose --save-dists ." 
  export PERL5LIB="$(pwd)/local/lib/perl5"
  cpanm --installdeps .
}

build() {
  cd "$srcdir/$_pkgname"

  cpanm --installdeps . -L"$PERL5LIB"
  cpanm -L"$PERL5LIB" App::cpm App::FatPacker::Simple Carton

  perl Build.PL
  ./Build build

  cd ./author
  perl fatpack.pl --update
}

check() {
  cd "$srcdir/$_pkgname"
  export PERL_MM_USE_DEFAULT=1
 ./Build testall
}

package() {
  cd "$srcdir/$_pkgname"

  cpanm  -L"$pkgdir/usr"
  INSTALLDIR="$pkgdir" ./Build install INSTALLDIR="$pkgdir"

  find "$pkgdir" -name '.packlist' -delete
}
